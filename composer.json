{
    "name": "medienbaecker/kirby-editoria11y",
    "description": "Editoria11y accessibility checker for Kirby editors",
    "license": "GPL-2.0-only",
    "type": "kirby-plugin",
    "version": "0.1.0",
    "authors": [
        {
            "name": "Thomas Günther",
            "email": "mail@medienbaecker.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "getkirby/composer-installer": "^1.2"
    },
    "config": {
        "allow-plugins": {
            "getkirby/composer-installer": true
        }
    },
    "archive": {
        "exclude": [
            ".DS_Store",
            ".editorconfig",
            ".gitattributes",
            ".gitignore"
        ]
    }
}
